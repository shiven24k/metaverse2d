# Standalone WebSocket server environment (apps/ws/.env)
# Only needed if you run WS as a separate process. The default combined
# HTTP+WS process reads apps/http/.env instead.

DATABASE_URL=postgresql://postgres:password@localhost:5432/metaverse
PORT=3001
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-this-to-a-random-secret-min-32-chars

# Internal admin kick endpoint (loopback only)
INTERNAL_PORT=4001
INTERNAL_KICK_SECRET=

# Optional horizontal scaling
USE_REDIS_ROOMS=false
REDIS_URL=redis://localhost:6379
