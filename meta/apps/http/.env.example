# HTTP + WebSocket server environment (apps/http/.env)
# This single process serves REST on PORT and attaches the WS server to it.

# Required
DATABASE_URL=postgresql://postgres:password@localhost:5432/metaverse
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-this-to-a-random-secret-min-32-chars

# Optional OAuth providers (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Billing — required for Razorpay subscriptions/checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email — Resend (optional; email steps become no-ops if unset)
RESEND_API_KEY=
RESEND_FROM="Metaverse 2D <no-reply@metaverse2d.com>"

# Frontend host used in transactional email links
APP_URL=http://localhost:5173

# Display currency fallback when not behind Cloudflare
GEOIP_FALLBACK=false

# TURN server (optional — Metered TURN credentials)
METERED_APP_NAME=
METERED_API_KEY=

# Cross-process member removal (required if running a standalone WS server)
INTERNAL_KICK_SECRET=
INTERNAL_KICK_URL=http://127.0.0.1:4001/internal/kick

# Signed access-request decision links
ACCESS_DECISION_SECRET=
